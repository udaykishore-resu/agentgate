        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "agentgate-prometheus" },
          "expr": "agentgate:retry_ratio:rate5m_by_backend{env=\"$env\",backend=~\"$backend\"}",
          "legendFormat": "{{backend}}"
        }
      ]
    },
    {
